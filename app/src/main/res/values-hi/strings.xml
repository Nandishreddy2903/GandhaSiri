    <!-- Before Planting -->
    <string name="legal_q1_title">क्या चंदन उगाना कानूनी है?</string>
    <string name="legal_q1_content">हाँ। कर्नाटक वन संशोधन अधिनियम 2001 के बाद से कर्नाटक में निजी भूमि पर चंदन उगाना पूरी तरह से कानूनी है। आपको केवल पेड़ लगाने के लिए किसी अनुमति की आवश्यकता नहीं है। हालांकि कटाई और बिक्री के लिए अलग-अलग परमिट की आवश्यकता होती है।</string>
    <string name="legal_q2_title">भूमि आवश्यकताएं</string>
    <string name="legal_q2_content">आपकी भूमि स्पष्ट शीर्षक वाली निजी स्वामित्व वाली पट्टा भूमि होनी चाहिए। आपके पास तहसीलदार द्वारा जारी एक वैध भूमि स्वामित्व प्रमाण पत्र होना चाहिए। सरकारी या वन विभाग की भूमि पर खेती की अनुमति नहीं है।</string>
    <string name="legal_q3_title">अपने वृक्षारोपण का पंजीकरण करें</string>
    <string name="legal_q3_content">रोपण के बाद आपको अपने स्थानीय जिला वन अधिकारी या मंडल वन अधिकारी के पास प्रत्येक चंदन के पेड़ का पंजीकरण करना होगा। अपने भूमि स्वामित्व दस्तावेज और उनके जीपीएस स्थानों के साथ पेड़ों की सूची ले जाएं। पंजीकरण शुल्क जिले के अनुसार अलग-अलग होता है। पंजीकरण रसीद को सुरक्षित रखें - यह आपके कानूनी स्वामित्व का प्रमाण है।</string>
    <string name="legal_q4_title">सरकारी सब्सिडी और ऋण</string>
    <string name="legal_q4_content">कर्नाटक सिरीचंदन वन योजना और कृषि अरण्य योजना के माध्यम से मुफ्त या रियायती चंदन के पौधे प्रदान करता है। पात्रता के लिए अपने स्थानीय बागवानी विभाग कार्यालय से संपर्क करें। कृषि बैंक किसान क्रेडिट योजनाओं के तहत चंदन के वृक्षारोपण के लिए कम ब्याज वाले ऋण प्रदान करते हैं।</string>

