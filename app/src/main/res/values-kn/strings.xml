    <!-- Before Planting -->
    <string name="legal_q1_title">ಶ್ರೀಗಂಧ ಬೆಳೆಯುವುದು ಕಾನೂನುಬದ್ಧವೇ?</string>
    <string name="legal_q1_content">ಹೌದು. ಕರ್ನಾಟಕ ಅರಣ್ಯ ತಿದ್ದುಪಡಿ ಕಾಯ್ದೆ 2001 ರ ನಂತರ ಕರ್ನಾಟಕದಲ್ಲಿ ಖಾಸಗಿ ಭೂಮಿಯಲ್ಲಿ ಶ್ರೀಗಂಧ ಬೆಳೆಯುವುದು ಸಂಪೂರ್ಣವಾಗಿ ಕಾನೂನುಬದ್ಧವಾಗಿದೆ. ಮರಗಳನ್ನು ನೆಡಲು ನೀವು ಯಾವುದೇ ಅನುಮತಿಯ ಅಗತ್ಯವಿಲ್ಲ. ಆದರೆ ಕಟಾವು ಮಾಡಲು ಮತ್ತು ಮಾರಾಟ ಮಾಡಲು ಪ್ರತ್ಯೇಕ ಪರವಾನಗಿಗಳ ಅಗತ್ಯವಿದೆ.</string>
    <string name="legal_q2_title">ಭೂಮಿಯ ಅವಶ್ಯಕತೆಗಳು</string>
    <string name="legal_q2_content">ನಿಮ್ಮ ಭೂಮಿಯು ಸ್ಪಷ್ಟ ಶೀರ್ಷಿಕೆಯೊಂದಿಗೆ ಖಾಸಗಿ ಒಡೆತನದ ಪಟ್ಟಾ ಭೂಮಿಯಾಗಿರಬೇಕು. ತಹಶೀಲ್ದಾರ್ ನೀಡಿದ ಮಾನ್ಯ ಭೂ ಮಾಲೀಕತ್ವದ ಪ್ರಮಾಣಪತ್ರವನ್ನು ನೀವು ಹೊಂದಿರಬೇಕು. ಸರ್ಕಾರಿ ಅಥವಾ ಅರಣ್ಯ ಇಲಾಖೆಯ ಭೂಮಿಯಲ್ಲಿ ಕೃಷಿ ಮಾಡಲು ಅನುಮತಿಯಿಲ್ಲ.</string>
    <string name="legal_q3_title">ನಿಮ್ಮ ತೋಟವನ್ನು ನೋಂದಾಯಿಸಿ</string>
    <string name="legal_q3_content">ನಾಟಿ ಮಾಡಿದ ನಂತರ ನೀವು ಪ್ರತಿ ಶ್ರೀಗಂಧದ ಮರವನ್ನು ನಿಮ್ಮ ಸ್ಥಳೀಯ ಜಿಲ್ಲಾ ಅರಣ್ಯ ಅಧಿಕಾರಿ ಅಥವಾ ವಿಭಾಗೀಯ ಅರಣ್ಯ ಅಧಿಕಾರಿಯ ಬಳಿ ನೋಂದಾಯಿಸಬೇಕು. ನಿಮ್ಮ ಭೂ ಮಾಲೀಕತ್ವದ ದಾಖಲೆಗಳನ್ನು ಮತ್ತು ಅವುಗಳ ಜಿಪಿಎಸ್ ಸ್ಥಳಗಳೊಂದಿಗೆ ಮರಗಳ ಪಟ್ಟಿಯನ್ನು ಕೊಂಡೊಯ್ಯಿರಿ. ನೋಂದಣಿ ಶುಲ್ಕ ಜಿಲ್ಲಾವಾರು ಬದಲಾಗುತ್ತದೆ. ನೋಂದಣಿ ರಶೀದಿಯನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಿ - ಇದು ನಿಮ್ಮ ಕಾನೂನುಬದ್ಧ ಮಾಲೀಕತ್ವದ ಪುರಾವೆಯಾಗಿದೆ.</string>
    <string name="legal_q4_title">ಲಭ್ಯವಿರುವ ಸರ್ಕಾರಿ ಯೋಜನೆಗಳು</string>
    <string name="legal_q4_content">ಕರ್ನಾಟಕವು ಸಿರಿಚಂದನ ವನ ಯೋಜನೆ ಮತ್ತು ಕೃಷಿ ಅರಣ್ಯ ಯೋಜನೆಯ ಮೂಲಕ ಉಚಿತ ಅಥವಾ ಸಬ್ಸಿಡಿ ದರದ ಶ್ರೀಗಂಧದ ಸಸಿಗಳನ್ನು ನೀಡುತ್ತದೆ. ಅರ್ಹತೆಗಾಗಿ ನಿಮ್ಮ ಸ್ಥಳೀಯ ತೋಟಗಾರಿಕೆ ಇಲಾಖೆಯ ಕಚೇರಿಯನ್ನು ಸಂಪರ್ಕಿಸಿ. ಕೃಷಿ ಬ್ಯಾಂಕುಗಳು ಕಿಸಾನ್ ಕ್ರೆಡಿಟ್ ಯೋಜನೆಗಳ ಅಡಿಯಲ್ಲಿ ಶ್ರೀಗಂಧದ ತೋಟಕ್ಕಾಗಿ ಕಡಿಮೆ ಬಡ್ಡಿದರದ ಸಾಲಗಳನ್ನು ನೀಡುತ್ತವೆ.</string>

