    <string name="legal_disclaimer_title">Legal Disclaimer</string>
    <string name="legal_disclaimer_text">This information is based on Karnataka Forest Act 1963, Karnataka Forest Amendment Act 2001, and Karnataka Forest Amendment Rules 2022. Laws may change. Always verify current rules with your local District Forest Officer before taking any action.</string>
    
